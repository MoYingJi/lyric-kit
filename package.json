{
  "name": "lyric-kit",
  "version": "0.5.3",
  "description": "A lightweight, zero-dependency toolkit for parsing, serializing, and processing lyrics across multiple formats (LRC, TTML, QRC, YRC, KRC, LyS, SRT, ASS).",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "author": {
    "name": "imsyy",
    "email": "imsyy1024@gmail.com",
    "url": "https://imsyy.top"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SPlayer-Dev/lyric-kit.git"
  },
  "homepage": "https://github.com/SPlayer-Dev/lyric-kit#readme",
  "bugs": {
    "url": "https://github.com/SPlayer-Dev/lyric-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.zh-CN.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "keywords": [
    "lyric",
    "lyrics",
    "lrc",
    "ttml",
    "qrc",
    "yrc",
    "krc",
    "parser",
    "karaoke",
    "subtitles"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "happy-dom": "^20.13.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  },
  "license": "AGPL-3.0"
}
